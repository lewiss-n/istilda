# Copy this file to .env and fill it in.

# Password for the admin area at /admin (you can change it later in Admin > Settings).
ADMIN_PASSWORD=password123

# Your WhatsApp number in international format, e.g. 254712345678.
# You can also set or change it later in Admin > Settings.
WHATSAPP_NUMBER=254708208991

# Optional: a long random string used to sign admin logins.
# If left empty, one is generated and stored with your data.
SESSION_SECRET=sdfsdf34534fsdfvsdf

# Set to true once the site is served over HTTPS (recommended), or leave empty to detect automatically.
COOKIE_SECURE=

# ---- Database (PostgreSQL) ----

# Password for the PostgreSQL database that Docker creates. Use a long random string of
# letters and numbers only, and don't change it after the first start.
# Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# How many days of daily database backups to keep in ./backups (Docker only).
BACKUP_KEEP_DAYS=14

# Only when running WITHOUT Docker (Docker sets this for you):
# DATABASE_URL=postgres://istilda:YOUR_PASSWORD@localhost:5432/istilda
# For a hosted database that requires SSL, also set: DATABASE_SSL=true

# ---- Demo on Vercel (see "Show a demo on Vercel" in README.md) ----
# On Vercel, set these in Project Settings > Environment Variables instead of in a file.
# DEMO_MODE=true               notice for visitors, sample data, no search indexing, password locked
# CRON_SECRET=                 long random string; protects the daily clean-up Vercel runs
# DATABASE_URL and BLOB_READ_WRITE_TOKEN are added for you when you connect Neon and a Blob store.
